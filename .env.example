# Kopjoje këtë skedar si .env.local dhe plotëso vlerat.
# KUJDES: çdo variabël EXPO_PUBLIC_* futet në paketën e aplikacionit dhe është
# e lexueshme nga kushdo. Mos vendos kurrë sekrete, fjalëkalime ose kredenciale
# databaze këtu.

# Adresa bazë e Distribo API (HTTPS e detyrueshme në prodhim).
# Në zhvillim mund të lihet bosh: aplikacioni përdor automatikisht kompjuterin që shërben Metro.
EXPO_PUBLIC_API_URL=

# Porti i API-së lokale në zhvillim (përdoret vetëm kur EXPO_PUBLIC_API_URL është bosh).
EXPO_PUBLIC_DEV_API_PORT=5180

# Monedha dhe formatimi i çmimeve.
EXPO_PUBLIC_CURRENCY_CODE=ALL
EXPO_PUBLIC_CURRENCY_SYMBOL=L
EXPO_PUBLIC_CURRENCY_DECIMALS=0
